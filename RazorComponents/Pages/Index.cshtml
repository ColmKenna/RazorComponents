@page
@model IndexModel
@{
    ViewData["Title"] = "Home page";
}

<div class="text-center">
    <h1 class="display-4">Welcome</h1>
    <p>Learn about <a href="https://learn.microsoft.com/aspnet/core">building Web apps with ASP.NET Core</a>.</p>
    
    
    @* add link to arrayeditor edit *@
      <p>
        <a class="btn btn-primary" href="@Url.Page("/SampleUses/ArrayEditor/Edit")">Array Editor Sample</a>
    </p>
    <p>
        <a class="btn btn-secondary" href="@Url.Page("/SampleUses/Dialog/Example")">DialogViewComponent Sample</a>
    </p>
    <p>
        <a class="btn btn-info" href="@Url.Page("/SampleUses/Tab/Example")">Tab Helper Sample</a>
    </p>
    <p>
        <a class="btn btn-success" href="@Url.Page("/SampleUses/EditArrayTagHelper/Index")">EditArrayTagHelper Examples</a>
    </p>
    
    <p>
        <a class="btn btn-warning" href="@Url.Page("/SampleUses/EditArray/EditArraySample")">EditArray Sample</a>
    </p>

    <hr />
    <h3>DisplayTagHelper Samples</h3>
    <div class="d-grid gap-2 d-sm-block">
        <a class="btn btn-outline-primary" asp-page="/SampleUses/Display/BasicUsage">Basic Usage</a>
        <a class="btn btn-outline-secondary" asp-page="/SampleUses/Display/CustomStyling">Custom Styling</a>
        <a class="btn btn-outline-info" asp-page="/SampleUses/Display/ComplexUsage">Complex Models</a>
    </div>
    
    <hr />
    <h3>Multiselect Checkbox Samples</h3>
    <div class="d-grid gap-2 d-sm-block">
        <a class="btn btn-outline-success" asp-page="/SampleUses/Multiselect/BasicUsage">Basic Usage</a>
        <a class="btn btn-outline-primary" asp-page="/SampleUses/Multiselect/CustomStyling">Custom Styling</a>
        <a class="btn btn-outline-info" asp-page="/SampleUses/Multiselect/Themes">Themes</a>
        <a class="btn btn-outline-warning" asp-page="/SampleUses/Multiselect/EmptyState">Empty State</a>
        <a class="btn btn-outline-dark" asp-page="/SampleUses/Multiselect/JavaScriptEvents">JavaScript Events</a>
    </div>
    
    
    
    
    
</div>

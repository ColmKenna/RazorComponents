@page
@model RazorComponents.Pages.SampleUses.FlipCard.VerticalFlipModel
@{
    ViewData["Title"] = "Flip Card - Vertical Flip";
}

<link rel="stylesheet" href="~/components/FlipCard/FlipCard.css" asp-append-version="true" />

<div class="container mt-5">
    <h1 class="mb-2">Flip Card - Vertical Flip</h1>
    <p class="lead text-muted">Flip on the X-axis and use auto-height for uneven content.</p>

    <div class="row g-4">
        <div class="col-md-6">
            <flip-card size="@(new FlipCardSize { Width = "320px", Height = "240px" })" flip-direction="Vertical" button-text="Rotate">
                <card-front title="Front">
                    <p class="mb-2">Vertical flip rotates along the X-axis.</p>
                    <p class="mb-0 text-muted">Great for stacked or portrait layouts.</p>
                </card-front>
                <card-back title="Back">
                    <p class="mb-0">This uses the same height as the front.</p>
                </card-back>
            </flip-card>
        </div>
        <div class="col-md-6">
            <flip-card size="@(new FlipCardSize { Width = "320px" })" button-text="Flip">
                <card-front title="Auto Height">
                    <p class="mb-2">No fixed height set.</p>
                    <p class="mb-0">The component equalizes to the taller face automatically.</p>
                </card-front>
                <card-back title="More Content">
                    <p class="mb-2">Longer back content so you can see height matching.</p>
                    <ul class="mb-0">
                        <li>Item one</li>
                        <li>Item two</li>
                        <li>Item three</li>
                        <li>Item four</li>
                    </ul>
                </card-back>
            </flip-card>
        </div>
    </div>

    <div class="card p-3 mt-4">
        <h5 class="mb-2">Notes</h5>
        <ul class="small mb-0">
            <li>Set <code>flip-direction="Vertical"</code> for X-axis rotation.</li>
            <li>Omit <code>size</code> or omit <code>Height</code> in <code>FlipCardSize</code> for content-driven auto-height.</li>
            <li>The JavaScript component recalculates on load and resize.</li>
        </ul>
    </div>

    <p class="mt-3">
        <a asp-page="BasicUsage" class="btn btn-secondary">&larr; Basic Usage</a>
        <a asp-page="Sizing" class="btn btn-primary">Sizing &rarr;</a>
    </p>
</div>

@section Scripts {
    <script src="~/components/FlipCard/flip-card.js" asp-append-version="true"></script>
}

@page
@model RazorComponents.Pages.SampleUses.FlipCard.BasicUsageModel
@{
    ViewData["Title"] = "Flip Card - Basic Usage";
}

<link rel="stylesheet" href="~/components/FlipCard/FlipCard.css" asp-append-version="true" />

<div class="container mt-5">
    <h1 class="mb-2">Flip Card - Basic Usage</h1>
    <p class="lead text-muted">A simple flip card with default (horizontal) rotation.</p>

    <div class="row g-4">
        <div class="col-md-6">
            <flip-card size="@(new FlipCardSize { Width = "320px", Height = "240px" })" button-text="Flip Me">
                <card-front title="Overview">
                    <p class="mb-2">This card flips on the Y-axis by default.</p>
                    <ul class="mb-0">
                        <li>Front content</li>
                        <li>Header title</li>
                        <li>Flip button</li>
                    </ul>
                </card-front>
                <card-back title="Details">
                    <p class="mb-2">Back content can include any HTML.</p>
                    <button type="button" class="btn btn-sm btn-outline-primary">Learn more</button>
                </card-back>
            </flip-card>
        </div>
        <div class="col-md-6">
            <div class="card p-3 h-100">
                <h5 class="mb-2">When to use</h5>
                <p class="text-muted">
                    Flip cards are great for compact previews where the user can reveal more details on demand.
                </p>
                <h6 class="mt-3">Key attributes</h6>
                <ul class="small mb-0">
                    <li><code>size</code> for fixed sizing (omit for auto-fit)</li>
                    <li><code>button-text</code> to customize the flip action label</li>
                    <li><code>flip-direction</code> for horizontal or vertical flips</li>
                </ul>
            </div>
        </div>
    </div>

    <h3 class="mt-5">Code Example</h3>
    <pre><code>&lt;flip-card size="@@(new FlipCardSize { Width = "320px", Height = "240px" })" button-text="Flip Me"&gt;
    &lt;card-front title="Overview"&gt;
        &lt;p&gt;Front content...&lt;/p&gt;
    &lt;/card-front&gt;
    &lt;card-back title="Details"&gt;
        &lt;p&gt;Back content...&lt;/p&gt;
    &lt;/card-back&gt;
&lt;/flip-card&gt;

@* Or omit size entirely for auto-fit *@
&lt;flip-card button-text="Flip Me"&gt;...&lt;/flip-card&gt;</code></pre>

    <p class="mt-3">
        <a asp-page="/Index" class="btn btn-secondary">&larr; Back to Home</a>
        <a asp-page="VerticalFlip" class="btn btn-primary">Vertical Flip &rarr;</a>
    </p>
</div>

@section Scripts {
    <script src="~/components/FlipCard/flip-card.js" asp-append-version="true"></script>
}

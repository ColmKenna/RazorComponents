@page
@model RazorComponents.Pages.SampleUses.EditArrayTagHelper.BasicExample
@{
    ViewData["Title"] = "Basic EditArrayTagHelper Example";
}

<div class="container mt-5">
    <h1>Basic EditArrayTagHelper Example</h1>
    <p class="lead">Simple array editor with add/remove functionality</p>

    <form method="post">
        <div class="row">
            <div class="col-md-8">
                <div class="form-group mb-4">
                    <label asp-for="Person.FirstName" class="form-label">First Name</label>
                    <input asp-for="Person.FirstName" class="form-control" />
                    <span asp-validation-for="Person.FirstName" class="text-danger"></span>
                </div>

                <div class="form-group mb-4">
                    <label asp-for="Person.LastName" class="form-label">Last Name</label>
                    <input asp-for="Person.LastName" class="form-control" />
                    <span asp-validation-for="Person.LastName" class="text-danger"></span>
                </div>

                <hr class="my-5" />

                <h3 class="mb-4">Addresses (Basic)</h3>
                <p class="text-muted">Simple editor without display mode - just inline editing</p>

                <edit-array
                    asp-items="@Model.Person.Addresses"
                    asp-view-name="~/Pages/Shared/EditorTemplates/Address.cshtml"
                    asp-for="Person.Addresses"
                    asp-template="true"
                    asp-add-button="true"
                    id="addresses-basic">
                </edit-array>

                <div class="mt-4">
                    <button type="submit" class="btn btn-primary">Save Changes</button>
                    <a asp-page="Index" class="btn btn-secondary">Back to Examples</a>
                </div>
            </div>
        </div>
    </form>
</div>

@section Scripts {
    <script>
        function addNewItem(containerId, templateId) {
            const container = document.getElementById(containerId);
            const template = document.getElementById(templateId);
            const itemsContainer = container.querySelector('.edit-array-items');
            
            if (!template) {
                console.error('Template not found');
                return;
            }
            
            // Clone the template content
            const newItem = template.content.cloneNode(true);
            
            // Generate a unique index based on current items
            const itemCount = itemsContainer.children.length;
            const newIndex = itemCount;
            
            // Update all name attributes in the cloned content
            updateFieldNames(newItem, '__index__', newIndex);
            
            // Add the new item to the container
            itemsContainer.appendChild(newItem);
        }
        
        function updateFieldNames(element, oldIndex, newIndex) {
            // Update name attributes
            const inputs = element.querySelectorAll('[name*="' + oldIndex + '"]');
            inputs.forEach(input => {
                input.name = input.name.replace('[' + oldIndex + ']', '[' + newIndex + ']');
            });
            
            // Update id attributes if they exist
            const elementsWithId = element.querySelectorAll('[id*="' + oldIndex + '"]');
            elementsWithId.forEach(el => {
                el.id = el.id.replace('[' + oldIndex + ']', '[' + newIndex + ']');
            });
        }
    </script>
}

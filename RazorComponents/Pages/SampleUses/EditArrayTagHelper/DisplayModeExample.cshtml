@page
@model RazorComponents.Pages.SampleUses.EditArrayTagHelper.DisplayModeExample
@{
    ViewData["Title"] = "DisplayMode EditArrayTagHelper Example";
}

<div class="container mt-5">
    <h1>DisplayMode Example</h1>
    <p class="lead">Toggle between display and edit modes for a better UX</p>

    <form method="post">
        <div class="row">
            <div class="col-md-8">
                <div class="form-group mb-4">
                    <label asp-for="Person.FirstName" class="form-label">First Name</label>
                    <input asp-for="Person.FirstName" class="form-control" />
                </div>

                <div class="form-group mb-4">
                    <label asp-for="Person.LastName" class="form-label">Last Name</label>
                    <input asp-for="Person.LastName" class="form-control" />
                </div>

                <hr class="my-5" />

                <h3 class="mb-4">Addresses (Display/Edit Mode)</h3>
                <p class="text-muted">Click Edit to modify an address, or Delete to remove it</p>

                <edit-array
                    asp-items="@Model.Person.Addresses"
                    asp-view-name="~/Pages/Shared/EditorTemplates/Address.cshtml"
                    asp-display-view-name="~/Pages/Shared/DisplayTemplates/Address.cshtml"
                    asp-for="Person.Addresses"
                    asp-template="true"
                    asp-add-button="true"
                    asp-display-mode="true"
                    id="addresses-display"
                    asp-on-update="onAddressUpdate">
                </edit-array>

                <div class="mt-4">
                    <button type="submit" class="btn btn-primary">Save Changes</button>
                    <a asp-page="Index" class="btn btn-secondary">Back to Examples</a>
                </div>
            </div>
        </div>
    </form>
</div>

@section Scripts {
    <script>
        function onAddressUpdate(itemId) {
            console.log('Address updated:', itemId);
            // You can add custom logic here to handle updates
        }
    </script>
}

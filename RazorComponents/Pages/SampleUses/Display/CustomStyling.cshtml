@page
@model RazorComponents.Pages.SampleUses.Display.CustomStylingModel
@{
    ViewData["Title"] = "Display Tag Helper - Custom Styling";
}

<h1>Custom Styling</h1>
<p>Demonstrates using <code>label-class</code> and <code>display-class</code> attributes.</p>

<div class="card p-3 mb-3">
    <div class="mb-3">
        <display asp-for="Status" label-class="fw-bold text-secondary" display-class="text-success fw-bold" />
    </div>
    <div class="mb-3">
        <display asp-for="Priority" label-class="fw-bold text-secondary" display-class="text-danger border p-1 rounded" />
    </div>
</div>

@page
@model RazorComponents.Pages.SampleUses.Multiselect.BasicUsageModel
@addTagHelper *, RazorComponents
@{
    ViewData["Title"] = "Multiselect Checkbox - Basic Usage";
}

<h1>Multiselect Checkbox - Basic Usage</h1>
<p>This demonstrates the default behavior of the <code>&lt;multiselect-checkbox&gt;</code> tag helper.</p>

<div class="card p-3 mb-3">
    <multiselect-checkbox 
        title="Select Scopes"
        description="Choose which scopes to allow for this client."
        multiselect-for="SelectedScopes"
        multiselect-items="AvailableScopes"
        id-prefix="scope-checkbox"
        fieldset-id="scopes-fieldset" />
</div>

<h3>Code Example</h3>
<pre><code>&lt;multiselect-checkbox 
    title="Select Scopes"
    description="Choose which scopes to allow for this client."
    multiselect-for="SelectedScopes"
    multiselect-items="AvailableScopes"
    id-prefix="scope-checkbox"
    fieldset-id="scopes-fieldset" /&gt;</code></pre>

<p class="mt-3">
    <a asp-page="/Index" class="btn btn-secondary">← Back to Home</a>
    <a asp-page="CustomStyling" class="btn btn-primary">Custom Styling →</a>
</p>

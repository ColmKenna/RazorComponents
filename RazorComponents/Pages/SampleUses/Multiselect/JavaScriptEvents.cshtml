@page
@model RazorComponents.Pages.SampleUses.Multiselect.JavaScriptEventsModel
@addTagHelper *, RazorComponents
@{
    ViewData["Title"] = "Multiselect Checkbox - JavaScript Events";
}

<h1>Multiselect Checkbox - JavaScript Events</h1>
<p>This demonstrates the JavaScript event integration for the <code>&lt;multiselect-checkbox&gt;</code> tag helper.</p>

<style>
    .js-events-theme {
        /* Lighter background for unselected, darker background for selected */
        --ms-card-bg: #f8f9fa;
        --ms-option-pill-color: #212529;
        --ms-option-pill-active-bg: #0b5ed7;
        --ms-option-pill-active-color: #ffffff;
        --ms-surface-bg: #e9ecef;
    }
</style>

<div class="row">
    <div class="col-md-6">
        <div class="card p-3 mb-3 js-events-theme">
            <multiselect-checkbox 
                title="Select Scopes"
                description="Choose which scopes to allow. Selection changes trigger JavaScript events."
                multiselect-for="SelectedScopes"
                multiselect-items="AvailableScopes"
                id-prefix="js-demo-checkbox"
                fieldset-id="js-demo-fieldset" />
        </div>
    </div>
    <div class="col-md-6">
        <div class="card p-3 mb-3">
            <h5>Event Log</h5>
            <div id="event-log" class="border p-2" style="height: 200px; overflow-y: auto; font-family: monospace; font-size: 0.85rem;">
                <em class="text-muted">Events will appear here...</em>
            </div>
            <div class="mt-2">
                <button id="btn-select-all" class="btn btn-sm btn-outline-primary">Select All</button>
                <button id="btn-clear" class="btn btn-sm btn-outline-secondary">Clear All</button>
                <button id="btn-get-selected" class="btn btn-sm btn-outline-info">Get Selected</button>
            </div>
        </div>
    </div>
</div>

<h3 class="mt-4">JavaScript Events</h3>
<p>The multiselect component dispatches these custom events:</p>
<table class="table table-striped">
    <thead>
        <tr>
            <th>Event</th>
            <th>Dispatched On</th>
            <th>Event Detail</th>
        </tr>
    </thead>
    <tbody>
        <tr>
            <td><code>multiselectItemToggled</code></td>
            <td>Checkbox element</td>
            <td><code>{ value, checked, selectedValues }</code></td>
        </tr>
        <tr>
            <td><code>multiselectChanged</code></td>
            <td>Grid container</td>
            <td><code>{ selectedValues }</code></td>
        </tr>
    </tbody>
</table>

<h3>Code Example</h3>
<pre><code>// Listen for selection changes on the grid
const grid = document.querySelector('.multiselect-grid');

grid.addEventListener('multiselectChanged', (e) => {
    console.log('Selected values:', e.detail.selectedValues);
});

// Listen for individual checkbox toggles
grid.addEventListener('multiselectItemToggled', (e) => {
    console.log(`${e.detail.value} was ${e.detail.checked ? 'checked' : 'unchecked'}`);
});

// Programmatic API (requires importing the module)
import { getSelectedValues, selectAll, clearSelections } from './multiselect-checkbox.js';

const values = getSelectedValues(grid);
selectAll(grid);
clearSelections(grid);</code></pre>

<p class="mt-3">
    <a asp-page="/Index" class="btn btn-secondary">← Back to Home</a>
    <a asp-page="BasicUsage" class="btn btn-primary">Basic Usage →</a>
</p>

@section Scripts {
    <script src="~/components/Multiselect/multiselect-checkbox.js"></script>
    <script>
        document.addEventListener('DOMContentLoaded', () => {
            const grid = document.querySelector('.multiselect-grid');
            const eventLog = document.getElementById('event-log');
            
            function logEvent(message) {
                const time = new Date().toLocaleTimeString();
                const entry = document.createElement('div');
                entry.innerHTML = `<span class="text-muted">[${time}]</span> ${message}`;
                
                // Clear placeholder if first event
                if (eventLog.querySelector('em')) {
                    eventLog.innerHTML = '';
                }
                
                eventLog.appendChild(entry);
                eventLog.scrollTop = eventLog.scrollHeight;
            }
            
            // Listen for grid-level changes
            grid.addEventListener('multiselectChanged', (e) => {
                logEvent(`<strong>multiselectChanged:</strong> ${e.detail.selectedValues.join(', ') || '(none)'}`);
            });
            
            // Listen for individual item toggles
            grid.addEventListener('multiselectItemToggled', (e) => {
                const action = e.detail.checked ? '✓ checked' : '✗ unchecked';
                logEvent(`<strong>multiselectItemToggled:</strong> <code>${e.detail.value}</code> ${action}`);
            });
            
            // Button handlers
            document.getElementById('btn-select-all').addEventListener('click', () => {
                grid.querySelectorAll('input[type="checkbox"]').forEach(cb => {
                    if (!cb.checked) {
                        cb.checked = true;
                        cb.dispatchEvent(new Event('change', { bubbles: true }));
                    }
                });
            });
            
            document.getElementById('btn-clear').addEventListener('click', () => {
                grid.querySelectorAll('input[type="checkbox"]:checked').forEach(cb => {
                    cb.checked = false;
                    cb.dispatchEvent(new Event('change', { bubbles: true }));
                });
            });
            
            document.getElementById('btn-get-selected').addEventListener('click', () => {
                const checked = grid.querySelectorAll('input[type="checkbox"]:checked');
                const values = Array.from(checked).map(cb => cb.value);
                logEvent(`<strong>getSelectedValues:</strong> [${values.map(v => `"${v}"`).join(', ')}]`);
            });
        });
    </script>
}
